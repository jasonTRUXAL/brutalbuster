{
  "name": "brutalbuster",
  "private": true,
  "version": "0.1.0",
  "description": "A walk-in, first-person retro video store for browsing a YouTube channel's VHS transfers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync-youtube.mjs",
    "lint": "eslint .",
    "test": "node --test test/unit/*.test.mjs",
    "test:smoke": "playwright test",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:fast": "npm run lint && npm run check:catalog && npm test",
    "check": "npm run check:fast && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
